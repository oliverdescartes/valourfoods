# Add these to the EXISTING backend environment; do not replace its other settings.
META_PIXEL_ID=2927690960901306
META_CAPI_ACCESS_TOKEN=
# Existing backend/.env META_CAPI_TOKEN is supported as a server-only fallback.
META_GRAPH_API_VERSION=v26.0
PUBLIC_SITE_URL=https://liquidspice.in
NODE_ENV=production
# Used in development/test, or the explicit temporary staging override below.
# Leave empty in the live production deployment.
META_CAPI_TEST_EVENT_CODE=
# Explicit deployment identity; keep production on the live service.
META_DEPLOYMENT_ENV=production
# Staging may keep NODE_ENV=production. To test there only, set deployment identity
# to staging, enable this flag, and set a UTC ISO expiry within 24 hours of restart.
# PUBLIC_SITE_URL must be the staging origin, not either live liquidspice.in host.
META_CAPI_TEST_MODE=false
META_CAPI_TEST_MODE_UNTIL=
# Optional: comma-separated actual trusted reverse proxy IPs/CIDRs (never blanket trust).
META_TRUST_PROXY=
# Dataset Quality API is not implemented; no additional token is required.
