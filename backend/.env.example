PORT=3000
MONGO_URI=
OPENROUTER_API_KEY=
# Active WhatsApp transport (server-side only).
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=valour
# International digits-only format, e.g. 91XXXXXXXXXX.
GUPSHUP_SOURCE_NUMBER=
# Optional JSON map from existing template names (or name:language) to Gupshup template IDs.
# Example: {"order_confirmation:en_US":"00000000-0000-0000-0000-000000000000"}
GUPSHUP_TEMPLATE_IDS=
# Approved Gupshup template for the post-cook review prompt:
# "Glad you enjoyed your first VALOUR cook.\n\nWould you leave a quick review?
# It helps other people understand what it’s actually like to cook with VALOUR at home."
# Buttons: URL "Rate VALOUR" (one dynamic URL parameter), quick reply "Not now".
WHATSAPP_REVIEW_TEMPLATE_NAME=
WHATSAPP_REVIEW_TEMPLATE_LANGUAGE=en_US

# Approved templates used by the database-backed WhatsApp automation worker.
# Add each template's Gupshup ID to GUPSHUP_TEMPLATE_IDS above.
WHATSAPP_NEW_LEAD_TEMPLATE_NAME=
WHATSAPP_PRODUCT_DEMO_TEMPLATE_NAME=
WHATSAPP_HIGH_INTENT_TEMPLATE_NAME=
WHATSAPP_PRICE_DELIVERY_TEMPLATE_NAME=
WHATSAPP_CHECKOUT_REMINDER_TEMPLATE_NAME=
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_COD_TEMPLATE_NAME=
WHATSAPP_ORDER_STATUS_TEMPLATE_NAME=
WHATSAPP_DELIVERED_TEMPLATE_NAME=
WHATSAPP_COOKING_REMINDER_TEMPLATE_NAME=
WHATSAPP_POST_COOK_TEMPLATE_NAME=
WHATSAPP_REORDER_TEMPLATE_NAME=
WHATSAPP_AUTOMATION_TEMPLATE_LANGUAGE=en_US

# Queue defaults: poll every minute, retry temporary failures up to four times,
# and limit marketing messages to one per day / three per seven days.
WHATSAPP_JOB_POLL_MS=60000
WHATSAPP_JOB_MAX_ATTEMPTS=4
WHATSAPP_MARKETING_DAILY_CAP=1
WHATSAPP_MARKETING_WEEKLY_CAP=3
# Optional direct Meta fallback/debug configuration.
PHONE_NUMBER_ID=
AUTH_TOKEN=
WABA_ID=
ENABLE_META_WABA_SUBSCRIPTION=false
VERIFY_TOKEN=

# Razorpay test mode keys only. Do not put live keys in this testing setup.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Create this webhook in Razorpay for payment_link.paid, payment.captured,
# and payment.failed events.
# Endpoint: https://your-domain.example/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp order/shipping notifications.
# Public HTTPS URL for this site/API, e.g. https://yourdomain.com or ngrok URL.
PUBLIC_SITE_URL=
# Long random secret used to sign private order-tracking links.
# It also signs short-lived COD payment links; changing it invalidates existing links.
TRACKING_TOKEN_SECRET=
# Use an Indian number with country code, e.g. 919876543210.
DEFAULT_WHATSAPP_ORDER_PHONE=
# Must be a public HTTPS image URL that Meta can fetch.
WHATSAPP_ORDER_IMAGE_URL=
# Optional centralized media headers keyed by approved template name.
# Supported types: image, video, document. URLs must be public HTTPS links.
WHATSAPP_TEMPLATE_MEDIA={}
# Optional. If set, pass this as x-admin-token when updating shipping status.
ORDER_ADMIN_TOKEN=
