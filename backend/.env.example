PORT=3000
MONGO_URI=
OPENROUTER_API_KEY=
# Active WhatsApp transport (server-side only).
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=valour
# International digits-only format, e.g. 91XXXXXXXXXX.
GUPSHUP_SOURCE_NUMBER=
# Optional JSON map from existing template names (or name:language) to Gupshup template IDs.
# Example: {"order_confirmation:en_US":"00000000-0000-0000-0000-000000000000"}
GUPSHUP_TEMPLATE_IDS=

# Optional direct Meta fallback/debug configuration.
PHONE_NUMBER_ID=
AUTH_TOKEN=
WABA_ID=
ENABLE_META_WABA_SUBSCRIPTION=false
VERIFY_TOKEN=

# Razorpay test mode keys only. Do not put live keys in this testing setup.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Create this webhook in Razorpay for payment_link.paid, payment.captured,
# and payment.failed events.
# Endpoint: https://your-domain.example/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp order/shipping notifications.
# Public HTTPS URL for this site/API, e.g. https://yourdomain.com or ngrok URL.
PUBLIC_SITE_URL=
# Use an Indian number with country code, e.g. 919876543210.
DEFAULT_WHATSAPP_ORDER_PHONE=
# Must be a public HTTPS image URL that Meta can fetch.
WHATSAPP_ORDER_IMAGE_URL=
# Optional. If set, pass this as x-admin-token when updating shipping status.
ORDER_ADMIN_TOKEN=
