# Add these to the EXISTING backend environment; do not replace its other settings.
META_PIXEL_ID=2927690960901306
META_CAPI_ACCESS_TOKEN=
# Existing backend/.env META_CAPI_TOKEN is supported as a server-only fallback.
META_GRAPH_API_VERSION=v26.0
PUBLIC_SITE_URL=https://liquidspice.in
NODE_ENV=production
# Used in development/test, or the explicit temporary staging override below.
# Leave empty in the live production deployment.
META_CAPI_TEST_EVENT_CODE=
# Explicit deployment identity; keep production on the live service.
META_DEPLOYMENT_ENV=production
# Staging may keep NODE_ENV=production. To test there only, set deployment identity
# to staging, enable this flag, and set a UTC ISO expiry within 24 hours of restart.
# PUBLIC_SITE_URL must be the staging origin, not either live liquidspice.in host.
META_CAPI_TEST_MODE=false
META_CAPI_TEST_MODE_UNTIL=
# Optional: comma-separated actual trusted reverse proxy IPs/CIDRs (never blanket trust).
META_TRUST_PROXY=
# Dataset Quality API is not implemented; no additional token is required.

# WhatsApp deployment: publish the bundled files before changing these URLs.
# Compliance kill switch. Keep false during the account review. When eventually
# enabled, marketing still requires a stored, active "offers" opt-in per phone.
WHATSAPP_MARKETING_ENABLED=false
WHATSAPP_VELVETY_BUTTER_VIDEO_URL=https://liquidspice.in/whatsapp/cooking-tutorial.mp4
WHATSAPP_LID_OPENING_VIDEO_URL=https://liquidspice.in/whatsapp/open-the-lid.mp4
WHATSAPP_PRODUCT_IMAGE_URL=https://liquidspice.in/whatsapp/velvety-butter.png
WHATSAPP_ADMIN_NEW_ORDER_TEMPLATE_ID=680c3021-6889-4c60-86b4-6ebb0c7d7b1b
WHATSAPP_ADMIN_NEW_ORDER_TEMPLATE_LANGUAGE=en_US
# Sent only after a Razorpay payment-link callback converts an existing COD
# order to prepaid. Params: order number, amount paid, tracking button token.
WHATSAPP_COD_PREPAID_TEMPLATE_ID=515b2202-ab03-4fb3-a2de-32f896d04953
WHATSAPP_COD_PREPAID_TEMPLATE_LANGUAGE=en_US
# Optional JSON override for the exact body, footer and button labels displayed
# in the admin preview, keyed by automation key or configured template name.
WHATSAPP_TEMPLATE_TEXTS={}
# Registry audit only: obtain the actual app UUID from Gupshup, not the WABA ID.
GUPSHUP_APP_ID=
# Required: generate a private random token; set it in the provider callback URL
# as ?token=<secret>, or inject x-whatsapp-webhook-token at trusted ingress.
# POST /webhook requires it. The Gupshup endpoint also accepts recognized native
# provider payloads; keep the token in its callback URL for stronger verification.
WHATSAPP_WEBHOOK_TOKEN=
# Keep existing GUPSHUP_API_KEY / APP_NAME / SOURCE_NUMBER, template mappings,
# template media, and automation names. Never replace them with blank examples.
# ORDER_ADMIN_TOKEN must be nonempty for dashboard writes.
# Timings remain code constants: Delivered +15 minutes (09:00–20:00 IST), reorder +7 days.
